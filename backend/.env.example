# Salin menjadi backend/.env lalu isi.
# Kunci rahasia untuk login guru (min. 32 karakter acak). Buat dengan:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Kosongkan untuk SQLite lokal (backend/bulat.db). Untuk produksi pakai PostgreSQL:
# DATABASE_URL=postgresql://user:sandi@host/db
DATABASE_URL=

# Domain lain yang boleh memanggil API (dipisah koma), bila frontend di-hosting terpisah:
# CORS_ORIGINS=https://bulat.netlify.app
CORS_ORIGINS=

# Isi untuk mengizinkan guru mendaftar sendiri lewat API dengan kode ini (opsional).
KODE_DAFTAR_GURU=
